# Firecrawl API key (https://firecrawl.dev -> Dashboard -> API Keys)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# auto | basic | stealth  -- stealth burns more credits but gets past Cloudflare far more often
FIRECRAWL_PROXY=stealth
# ms to wait for client-side rendering before extraction
FIRECRAWL_WAIT_FOR=6000

# Optional: POST each new qualified job to Make/Zapier/n8n/Notion middleware
WEBHOOK_URL=
